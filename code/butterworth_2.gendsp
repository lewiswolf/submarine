				"box": {
					"code": "butterworth_2(x, b0, b1, b2, a0, a1) {\r\n\t// second order butterworth filter\n\tHistory mX1(0);\n\tHistory mX2(0);\n\tHistory mY1(0);\n\tHistory mY2(0);\r\n\t\n\ty = b0 * x + b1 * mX1 + b2 * mX2 - a0 * mY1 - a1 * mY2;\n\tmX2 = mX1;\n\tmX1 = x;\n\tmY2 = mY1;\n\tmY1 = y;\n\treturn y;\r\n}\r\n\r\n// calculate coefficients\r\nParam cutoff(2000.0, min=0.0);\r\nc = tan(pi * cutoff / SAMPLERATE);\r\nc2 = pow(c, 2.0);\nb0 = 1.0 / (1.0 + sqrt2 * c + c2);\r\nb1 = -2.0 * b0;\na0 = 2.0 * b0 * (c2 - 1.0);\na1 = b0 * (1.0 - sqrt2 * c + c2);\r\n\r\n// create LR filter with butterworth squared\r\nout1 = butterworth_2(butterworth_2(in1, b0, b1, b0, a0, a1), b0, b1, b0, a0, a1);",
					"fontface": 0,
					"fontname": "<Monospaced>",
					"fontsize": 12.0,
